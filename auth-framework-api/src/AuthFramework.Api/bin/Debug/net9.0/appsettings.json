{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=authframework;Username=authframework;Password=changeme"
  },
  "JwtSettings": {
    "Issuer": "AuthFramework",
    "Audience": "AuthFramework",
    "SecretKey": "REPLACE_WITH_STRONG_SECRET_KEY_MIN_32_CHARS",
    "AccessTokenExpiryMinutes": 15,
    "RefreshTokenExpiryDays": 30
  },
  "EncryptionSettings": {
    "Key": "REPLACE_WITH_BASE64_ENCODED_32_BYTE_KEY=="
  },
  "SessionSettings": {
    "LifetimeSec": 3600
  },
  "RateLimiting": {
    "LoginMaxAttempts": 5,
    "LoginWindowSeconds": 300,
    "GlobalRequestsPerMinute": 100
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "http://localhost:5173"
    ]
  },
  "Email": {
    "SmtpHost": "smtp.example.com",
    "SmtpPort": 587,
    "FromAddress": "noreply@authframework.example.com",
    "FromName": "AuthFramework",
    "EnableSsl": true
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {CorrelationId} {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/authframework-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30
        }
      }
    ],
    "Enrich": ["FromLogContext", "WithMachineName", "WithThreadId"]
  },
  "AllowedHosts": "*"
}
