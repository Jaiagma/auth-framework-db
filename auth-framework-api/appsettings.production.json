{
  "ConnectionStrings": {
    "DefaultConnection": "@Microsoft.KeyVault(VaultName=${KEY_VAULT_NAME};SecretName=db-connection-string)"
  },
  "JwtSettings": {
    "SecretKey": "@Microsoft.KeyVault(VaultName=${KEY_VAULT_NAME};SecretName=jwt-secret-key)",
    "Issuer": "https://${APP_SERVICE_NAME}.azurewebsites.net",
    "Audience": "authframework-api",
    "ExpiryMinutes": 30,
    "RefreshExpiryDays": 7
  },
  "EncryptionSettings": {
    "Key": "@Microsoft.KeyVault(VaultName=${KEY_VAULT_NAME};SecretName=encryption-key)"
  },
  "ApplicationInsights": {
    "ConnectionString": "@Microsoft.KeyVault(VaultName=${KEY_VAULT_NAME};SecretName=appinsights-connection-string)",
    "EnableAdaptiveSampling": true,
    "EnableDependencyTrackingTelemetryModule": true
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.ApplicationInsights",
      "Serilog.Sinks.Console"
    ],
    "MinimumLevel": {
      "Default": "Warning",
      "Override": {
        "Microsoft": "Error",
        "System": "Error",
        "Microsoft.EntityFrameworkCore": "Error"
      }
    },
    "WriteTo": [
      {
        "Name": "ApplicationInsights",
        "Args": {
          "connectionString": "@Microsoft.KeyVault(VaultName=${KEY_VAULT_NAME};SecretName=appinsights-connection-string)",
          "telemetryConverter": "Serilog.Sinks.ApplicationInsights.TelemetryConverters.TraceTelemetryConverter, Serilog.Sinks.ApplicationInsights"
        }
      },
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithEnvironmentName"
    ]
  },
  "HttpsRedirection": {
    "Enabled": true,
    "HttpsPort": 443
  },
  "Hsts": {
    "MaxAge": 31536000,
    "IncludeSubDomains": true,
    "Preload": true
  },
  "AllowedHosts": "*.azurewebsites.net",
  "Kestrel": {
    "EndpointDefaults": {
      "Protocols": "Http1AndHttp2"
    }
  }
}
