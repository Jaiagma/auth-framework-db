              { "key": "X-Tenant-ID", "value": "{{tenantId}}" }
            ],
            "url": { "raw": "{{baseUrl}}/api/mfa/devices/<device-id>", "host": ["{{baseUrl}}"], "path": ["api","mfa","devices","<device-id>"] }
          }
        },
        {
          "name": "Get Recovery Codes",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "X-Tenant-ID", "value": "{{tenantId}}" }
            ],
            "url": { "raw": "{{baseUrl}}/api/mfa/recovery-codes", "host": ["{{baseUrl}}"], "path": ["api","mfa","recovery-codes"] }
          }
        },
        {
          "name": "Regenerate Recovery Codes",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "X-Tenant-ID", "value": "{{tenantId}}" }
            ],
            "url": { "raw": "{{baseUrl}}/api/mfa/recovery-codes/regenerate", "host": ["{{baseUrl}}"], "path": ["api","mfa","recovery-codes","regenerate"] }
          }
        }
      ]
    },
    {
      "name": "OAuth",
      "item": [
        {
          "name": "Create Application",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const body = pm.response.json();",
                  "  if (body.clientId) pm.collectionVariables.set('clientId', body.clientId);",
                  "  if (body.clientSecret) pm.collectionVariables.set('clientSecret', body.clientSecret);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "X-Tenant-ID", "value": "{{tenantId}}" }
            ],
            "url": { "raw": "{{baseUrl}}/api/oauth/applications", "host": ["{{baseUrl}}"], "path": ["api","oauth","applications"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"My App\",\n  \"applicationType\": \"web\",\n  \"redirectUris\": [\"https://myapp.example.com/callback\"],\n  \"allowedScopes\": [\"read:profile\", \"write:profile\"]\n}"
            }
          }
        },
        {
          "name": "List Applications",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "X-Tenant-ID", "value": "{{tenantId}}" }
            ],
            "url": { "raw": "{{baseUrl}}/api/oauth/applications", "host": ["{{baseUrl}}"], "path": ["api","oauth","applications"] }
          }
        },
        {
          "name": "Authorize",
          "request": {
            "method": "GET",
            "header": [{ "key": "X-Tenant-ID", "value": "{{tenantId}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/oauth/authorize?client_id={{clientId}}&redirect_uri=https://myapp.example.com/callback&response_type=code&scope=read:profile&state=random_state",
              "host": ["{{baseUrl}}"],
              "path": ["api","oauth","authorize"],
              "query": [
                { "key": "client_id", "value": "{{clientId}}" },
                { "key": "redirect_uri", "value": "https://myapp.example.com/callback" },
                { "key": "response_type", "value": "code" },
                { "key": "scope", "value": "read:profile" },
                { "key": "state", "value": "random_state" }
              ]
            }
          }
        },
        {
          "name": "Token Exchange",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Tenant-ID", "value": "{{tenantId}}" }
            ],
            "url": { "raw": "{{baseUrl}}/api/oauth/token", "host": ["{{baseUrl}}"], "path": ["api","oauth","token"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"grantType\": \"authorization_code\",\n  \"code\": \"<authorization-code>\",\n  \"clientId\": \"{{clientId}}\",\n  \"clientSecret\": \"{{clientSecret}}\",\n  \"redirectUri\": \"https://myapp.example.com/callback\"\n}"
            }
          }
        },
        {
          "name": "Revoke Token",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Tenant-ID", "value": "{{tenantId}}" }
            ],
            "url": { "raw": "{{baseUrl}}/api/oauth/revoke", "host": ["{{baseUrl}}"], "path": ["api","oauth","revoke"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"<access-or-refresh-token>\",\n  \"clientId\": \"{{clientId}}\",\n  \"clientSecret\": \"{{clientSecret}}\"\n}"
            }
          }
        },
        {
          "name": "Introspect Token",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Tenant-ID", "value": "{{tenantId}}" }
            ],
            "url": { "raw": "{{baseUrl}}/api/oauth/introspect", "host": ["{{baseUrl}}"], "path": ["api","oauth","introspect"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"<token-to-inspect>\",\n  \"clientId\": \"{{clientId}}\",\n  \"clientSecret\": \"{{clientSecret}}\"\n}"
            }
          }
        }
      ]
    },
